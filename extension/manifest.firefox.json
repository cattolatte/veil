{
  "manifest_version": 3,
  "name": "Veil",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device visual perception for browser agents.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["src/background.js"], "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup/popup.html", "default_title": "Veil" },
  "browser_specific_settings": {
    "gecko": { "id": "veil@sih26171", "strict_min_version": "121.0" }
  }
}
